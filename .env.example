# Kopieren nach .env und ausfüllen. .env niemals committen.

# Discord Developer Portal → Application → Bot → Reset Token
DISCORD_TOKEN=

# Rechtsklick auf deinen Server → „Server-ID kopieren“ (Entwicklermodus nötig)
GUILD_ID=

# Login der Weboberfläche (http://localhost:8080). Wird beim ersten Start
# angelegt; danach unter „Konto“ änderbar. Ohne ADMIN_PASSWORD wird ein
# zufälliges Passwort erzeugt und einmalig im Container-Log ausgegeben.
ADMIN_USER=admin
ADMIN_PASSWORD=

# yt-dlp bei jedem Containerstart aktualisieren (empfohlen)
YTDLP_AUTO_UPDATE=true

# Log-Format: text oder json (optional)
LOG_FORMAT=text

# Log-Level (optional)
RUST_LOG=info,serenity=warn,songbird=warn
